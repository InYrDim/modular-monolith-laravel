{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "DISABLE_TELEMETRY": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false"
    },
    "permissions": {
        "allow": [
            "Bash(php artisan test:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(composer test)",
            "Bash(composer ci:check)",
            "Bash(npm run check)",
            "Bash(npm run types:check)",
            "Bash(npm run build)",
            "Bash(php artisan wayfinder:generate:*)",
            "Bash(php artisan route:list:*)"
        ],
        "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./storage/*.key)",
            "Artifact",
            "EnterPlanMode",
            "ExitPlanMode",
            "DesignSync",
            "NotebookEdit",
            "SendMessage",
            "PushNotification",
            "RemoteTrigger",
            "ReportFindings",
            "ScheduleWakeup",
            "AskUserQuestion",
            "CronCreate",
            "CronDelete",
            "CronList",
            "PowerShell" ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.php\""
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.php\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-php.php\""
                    }
                ]
            }
        ]
    },
    "skillOverrides": {
        "anthropic-skills:skill-creator": "off",
        "anthropic-skills:docx": "off",
        "anthropic-skills:google-workspace": "off",
        "anthropic-skills:pdf": "off",
        "anthropic-skills:pptx": "off",
        "anthropic-skills:xlsx": "off",
        "anthropic-skills:built-in-browser": "off",
        "anthropic-skills:chrome-browser": "off",
        "anthropic-skills:docs": "off",
        "anthropic-skills:morning": "off",
        "worktree-feature": "off"
    },
    "disableClaudeAiConnectors": true,
    "disableBundledSkills": true,
    "disableRemoteControl": true,
    "disableWorkflows": true,
    "disableArtifact": true,
    "prefersReducedMotion": true,
    "spinnerTipsEnabled": false
}
