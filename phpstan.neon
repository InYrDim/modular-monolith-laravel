includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - modules/
        - routes/
        - tests/

    ignoreErrors:
        # Pest's higher-order test API and expectation mixin are dynamic.
        - '#Call to an undefined method Pest.PendingCalls.TestCall::.*#'
        - '#Access to an undefined property Pest.PendingCalls.TestCall::.*#'
        - '#Access to an undefined property Pest.Mixins.Expectation.*::.*#'

    level: 7
